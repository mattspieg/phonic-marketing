# Copy this file to .dev.vars for local Worker development.
# Never commit real values.

# Used by the Phonic Worker (wrangler.toml).
PHONIC_API_KEY=

# Used by the Attio Worker (wrangler.attio.toml).
ATTIO_API_TOKEN=
WEBFLOW_WEBHOOK_SECRET=

# Optional: only used when PHONIC_OUTBOUND_MODE is set to "sip".
PHONIC_SIP_ADDRESS=
PHONIC_FROM_PHONE_NUMBER=
PHONIC_SIP_AUTH_USERNAME=
PHONIC_SIP_AUTH_PASSWORD=
